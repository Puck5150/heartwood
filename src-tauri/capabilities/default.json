{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "allow-delete-session-with-note",
    "allow-delete-all-data",
    "allow-initialize-note-storage",
    "allow-save-session-note",
    "allow-load-session-note",
    "allow-load-all-session-notes",
    "allow-open-notes-folder",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
